# Copia este archivo como `secrets.toml` (local) o pégalo en
# Streamlit Cloud → Settings → Secrets.
#
# Sin esta sección la app funciona igual, pero sólo con descarga de .ics
# (se oculta el botón de envío directo a Google Calendar).
#
# Cómo obtener estos valores: consulta docs/DESPLIEGUE.md → Parte B

[google_oauth]
client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional. Si se omite, la app usa su propia URL, que es lo correcto en
# Streamlit Cloud y en local. Sólo ponlo si usas un dominio propio o un proxy,
# y entonces debe ser idéntico al URI registrado en Google Cloud.
# redirect_uri = "https://tu-app.streamlit.app/"
